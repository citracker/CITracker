@using CITracker.Resources
@using Shared.Enumerations 
@model Shared.ViewModels.DashboardVM

@{
    ViewData["Title"] = "CI Tracker";
    ViewData["Active"] = "Dashboard";
    Layout = "~/Views/Shared/_MainDashboardLayout.cshtml";
}


<div class="main-content app-content">
    <div class="container-fluid px-3 px-md-4">


        <!-- ============================================================ -->
        <!--  FLOATING TABS  (fixed at top)                                -->
        <!-- ============================================================ -->
        <nav class="floating-tabs" id="floatingTabs">
            <ul class="nav nav-tabs" id="floatingTabList" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-target="section-ci" type="button">
                        <i class="ri-filter-3-line"></i> Continuous Improvement
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-target="section-oe" type="button">
                        <i class="ri-dashboard-3-line"></i> Operational Excellence
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-target="section-si" type="button">
                        <i class="ri-bar-chart-2-line"></i> Strategic Initiatives
                    </button>
                </li>
            </ul>
        </nav>

        <div class="row row-sm">
            <div class="accordion accordion-primary mb-5" id="filterAccord">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="filterHeader">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilter" aria-controls="collapseFilter">@SharedResource.FilterResults</button>
                    </h2>
                    <div id="collapseFilter" class="accordion-collapse collapse" aria-labelledby="filterHeader" data-bs-parent="#filterAccord">
                        <div class="accordion-body">
                            <div id="filterForm">
                                <div class="row gy-4">
                                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12">
                                        <div class="form-group">
                                            <div class="input-group">
                                                <div class="input-group-text text-muted"> <i class="ri-calendar-line"></i> </div>
                                                <input type="text" class="form-control flatpickr-input active" id="startdate" name="startdate" placeholder="@SharedResource.StartDate" readonly="readonly">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12">
                                        <div class="form-group">
                                            <div class="input-group">
                                                <div class="input-group-text text-muted"> <i class="ri-calendar-line"></i> </div>
                                                <input type="text" class="form-control flatpickr-input active" id="enddate" name="enddate" placeholder="@SharedResource.EndDate" readonly="readonly">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12">
                                        <select class="form-control" id="priority" name="priority">
                                            <option selected disabled value="">@SharedResource.SelectPriority</option>
                                            <option value="All">All</option>
                                            <option value="High">High</option>
                                            <option value="Medium">Medium</option>
                                            <option value="Low">Low</option>
                                        </select>
                                    </div>
                                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12">
                                        <select class="form-control" name="users" id="users">
                                            <option selected disabled value="">@SharedResource.SelectFacilitatorSponsor</option>
                                            <option value="All">All</option>
                                            @if (Model.OrganizationUser != null)
                                            {
                                                if (Model.OrganizationUser.Any())
                                                {
                                                    foreach (var i in Model.OrganizationUser)
                                                    {
                                                        <option value="@i.Id">@i.Name</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12">
                                        <select class="form-control" id="country" name="country">
                                            <option selected disabled value="">@SharedResource.SelectCountry</option>
                                            @if (Model.OrganizationCountry != null)
                                            {
                                                if (Model.OrganizationCountry.Any())
                                                {
                                                    foreach (var country in Model.OrganizationCountry)
                                                    {
                                                        <option value="@country.Id">@country.Country</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12">
                                        <select class="form-control" id="department" name="department">
                                            <option selected disabled value="">@SharedResource.SelectGroupFunction</option>
                                            @if (Model.OrganizationDepartment != null)
                                            {
                                                if (Model.OrganizationDepartment.Any())
                                                {
                                                    foreach (var i in Model.OrganizationDepartment)
                                                    {
                                                        <option value="@i.Id">@i.Department</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12">
                                        <select class="form-control" name="status" id="status" required>
                                            <option selected disabled value="">@SharedResource.SelectAStatus</option>
                                            @foreach (Status item in Enum.GetValues(typeof(Status)))
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12">
                                        <button type="button" id="applyFilterBtn" class="btn btn-success me-5">@SharedResource.Submit</button>
                                        <button type="button" id="clearFilterBtn" class="btn btn-outline-dark btn-wave">@SharedResource.Clear</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


