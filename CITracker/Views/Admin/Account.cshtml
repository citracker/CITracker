@using CITracker.Resources
@model Shared.DTO.OrganizationAccountDTO

@{
    ViewData["Title"] = "CI Tracker";
    ViewData["Base"] = "UserManagement";
    ViewData["Active"] = "Account";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="main-content app-content"> 
    <div class="container-fluid"> 
        <!-- Page Header --> 
        <div class="d-md-flex d-block align-items-center justify-content-between page-header-breadcrumb"> 
            <div> 
                <h2 class="main-content-title fs-24 mb-1">@SharedResource.MyAccount</h2> 
                @* <ol class="breadcrumb mb-0"> 
                    <li class="breadcrumb-item"><a href="javascript:void(0)"></a></li> 
                    <li class="breadcrumb-item active" aria-current="page"></li> 
                </ol> *@
            </div> 
            <div class="d-flex">
                <div class="justify-content-center"> 
                    @* <button type="button" class="btn btn-white btn-icon-text my-2 me-2 d-inline-flex align-items-center"> <i class="fe fe-download me-2 fs-14"></i> Import </button> 
                    <button type="button" class="btn btn-white btn-icon-text my-2 me-2 d-inline-flex align-items-center"> <i class="fe fe-filter me-2 fs-14"></i> Filter </button> 
                    <button type="button" class="btn btn-primary my-2 btn-icon-text d-inline-flex align-items-center"> <i class="fe fe-download-cloud me-2 fs-14"></i> Download Report </button>  *@
                </div> 
            </div> 
        </div> 
        <!-- Page Header Close --> 
        <!-- Start::row-1 --> 
        <div class="row square row-sm"> 
            <div class="col-lg-12 col-md-12"> 
                <div class="card custom-card"> 
                    <div class="card-body"> 
                        <div class="panel profile-cover"> 
                            <div class="profile-cover__img"> 
                                <img src="~/assets/images/faces/1.jpg" alt="img"> 
                                <h3 class="h3">@Model.Account.Name</h3> 
                            </div> 
                            @* <div class="btn-profile"> 
                                <button class="btn rounded-10 btn-danger"> <i class="fa fa-plus"></i> <span>Follow</span> </button> 
                                <button class="btn rounded-10 btn-success"> <i class="fa fa-comment"></i> <span>Message</span> </button> 
                            </div>  *@
                            <div class="profile-cover__action bg-img"></div> 
                            <div class="profile-cover__info"> 
                                <ul class="nav"> 
                                    <li><strong>@Model.Account.ActiveProjectCount</strong>@SharedResource.ActiveProjects</li>
                                    <li><strong>@Model.Account.ClosedProjectCount</strong>@SharedResource.ClosedProjects</li>
                                    <li><strong>@Model.Subscription.NumberOfUsedLicences</strong>@SharedResource.User</li>
                                </ul> 
                            </div> 
                        </div> 
                        <div class="profile-tab tab-menu-heading"> 
                            <nav class="nav main-nav-line p-3 tabs-menu profile-nav-line" role="tablist"> 
                                <a class="nav-link active" data-bs-toggle="tab" href="#about" aria-selected="true" role="tab">About</a> 
                                @* <a class="nav-link" data-bs-toggle="tab" href="#edit" aria-selected="false" role="tab" tabindex="-1">Edit Profile</a> 
                                <a class="nav-link" data-bs-toggle="tab" href="#timeline" aria-selected="false" role="tab" tabindex="-1">Timeline</a> 
                                <a class="nav-link" data-bs-toggle="tab" href="#gallery" aria-selected="false" role="tab" tabindex="-1">Gallery</a> 
                                <a class="nav-link" data-bs-toggle="tab" href="#friends" aria-selected="false" role="tab" tabindex="-1">Friends</a>
                                <a class="nav-link" data-bs-toggle="tab" href="#settings" aria-selected="false" role="tab" tabindex="-1">Account Settings</a> *@
                            </nav> 
                        </div> 
                    </div> 
                </div> 
            </div> 
        </div> 
        <!-- Row --> 
        <div class="row row-sm"> 
            <div class="col-lg-12 col-md-12"> 
                <div class="card custom-card main-content-body-profile"> 
                    <div class="tab-content"> 
                        <div class="main-content-body tab-pane p-4 border-top-0 active show" id="about" role="tabpanel">
                            <div class="border rounded-10"> 
                                @{
                                    var subStatus = Model.Subscription.SubscriptionStatus ?? "ACTIVE";
                                    var isCancelling = Model.Subscription.CancelAtPeriodEnd;
                                    var isCancelled = string.Equals(subStatus, "CANCELLED", StringComparison.OrdinalIgnoreCase);
                                    var isActive = !isCancelled && !isCancelling;
                                    var endDateStr = Convert.ToDateTime(Model.Subscription.EndDate).ToString("dd MMM yyyy");
                                }

                                <div class="p-4">
                                    <h4 class="fs-15 text-uppercase mb-3">Subscription</h4>

                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="text-primary mb-1 fs-14">
                                                @Model.Subscription.SubscriptionName @SharedResource.Plan
                                            </h5>

                                            <p class="mb-1">
                                                <b>@Model.Subscription.NumberOfUsedLicences</b> of
                                                <b>@Model.Subscription.NumberOfLicences</b> @SharedResource.LicensesUsed
                                            </p>
                                            <p class="mb-1">
                                                @SharedResource.StartDate:
                                                <b>@Convert.ToDateTime(Model.Subscription.StartDate).ToString("dd MMM yyyy")</b>
                                            </p>
                                            <p class="mb-1">
                                                @SharedResource.EndDate:
                                                <b>@endDateStr</b>
                                            </p>
                                        </div>

                                        <div class="text-end">
                                            @if (isActive)
                                            {
                                                <button class="btn rounded-10 btn-danger"
                                                        onclick="cancelSubscription()">
                                                    <i class="fa fa-ban"></i>
                                                    <span>@SharedResource.CancelSubscription</span>
                                                </button>
                                            }
                                            else if (isCancelling)
                                            {
                                                <button class="btn rounded-10 btn-success"
                                                        onclick="reactivateSubscription()">
                                                    <i class="fa fa-refresh"></i>
                                                    <span>Reactivate subscription</span>
                                                </button>
                                            }
                                            else if (isCancelled)
                                            {
                                                <a class="btn rounded-10 btn-primary"
                                                   asp-controller="Home" asp-action="Index">
                                                    <i class="fa fa-plus"></i>
                                                    <span>Resubscribe</span>
                                                </a>
                                            }
                                        </div>
                                    </div>

                                    @* Status banner *@
                                    @if (isCancelling)
                                    {
                                        <p class="text-warning mt-2 mb-0">
                                            <i class="fa fa-info-circle"></i>
                                            Your subscription will end on <b>@endDateStr</b>.
                                            You will not be charged again.
                                        </p>
                                    }
                                    else if (isCancelled)
                                    {
                                        <p class="text-danger mt-2 mb-0">
                                            <i class="fa fa-times-circle"></i>
                                            Your subscription has ended.
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-muted mt-2 mb-0">
                                            <i class="fa fa-check-circle"></i>
                                            Renews automatically on <b>@endDateStr</b>.
                                        </p>
                                    }
                                </div>
                                <div class="border-top"></div>
                                <div class="p-4"> 
                                    <label class="main-content-label fs-13 mg-b-20">@Model.Account.AdminName</label> 
                                    <div class="d-sm-flex"> 
                                        <div class="mb-3 mb-sm-0"> 
                                            <div class="main-profile-contact-list"> 
                                                <div class="media"> 
                                                    <div class="media-icon bg-primary-transparent text-primary"> <i class="bi bi-telephone-forward"></i> </div> 
                                                    <div class="media-body"> 
                                                        <span>@SharedResource.PhoneNumber</span>
                                                        <div> @Model.Account.AdminPhoneNumber</div> 
                                                    </div> 
                                                </div> 
                                            </div> 
                                        </div>
                                        <div class="mb-3 mb-sm-0">
                                            <div class="main-profile-contact-list">
                                                <div class="media">
                                                    <div class="media-icon bg-primary-transparent text-primary"> <i class="bi bi-envelope-fill"></i> </div>
                                                    <div class="media-body">
                                                        <span>@SharedResource.EmailAddress</span>
                                                        <div> @Model.Account.AdminEmail</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="ms-0 ms-sm-3 mb-3 mb-sm-0"> 
                                            <div class="main-profile-contact-list"> 
                                                <div class="media"> 
                                                    <div class="media-icon bg-info-transparent text-info"> <i class="bi bi-geo-alt"></i> </div> 
                                                    <div class="media-body">
                                                        <span>@SharedResource.CurrentAddress</span>
                                                        <div> @Model.Account.Address </div> 
                                                    </div> 
                                                </div> 
                                            </div> 
                                        </div> 
                                    </div> 
                                </div> 
                            </div> 
                        </div>                         
                    </div> 
                </div> 
            </div> 
        </div> 
        <!-- End Row --> 
        <!--End::row-1 --> 
    </div>
</div>
<script>
    const resources = {
        cancelSub: '@SharedResource.AreYouSureYouWantToCancelYourSubscription',
        cancelSubResp: '@SharedResource.SubscriptionCancellationRequestSubmittedSuccessfully',
        someWentWrong: '@SharedResource.SomethingWentWrong'
    };

    let eligibility = null;

    // ── Cancel ─────────────────────────────────────────────────────
    async function cancelSubscription() {
        if (!confirm(resources.cancelSub)) return;

        try {
            const res = await fetch('/api/subscription/cancel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ atPeriodEnd: true })
            });
            const data = await res.json();
            if (!res.ok) { alert(data.message || resources.someWentWrong); return; }
            alert(data.message);
            location.reload();
        } catch (err) {
            console.error(err);
            alert(resources.someWentWrong);
        }
    }

    // ── Reactivate ─────────────────────────────────────────────────
    async function reactivate() {
        const res = await fetch('/api/subscription/cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ atPeriodEnd: false })
        });
        const data = await res.json();
        if (!res.ok) { alert(data.message || resources.someWentWrong); return; }
        location.reload();
    }

    // ── Upgrade modal ──────────────────────────────────────────────
    async function loadEligibility() {
        const res = await fetch('/api/subscription/eligibility');
        if (!res.ok) return;
        eligibility = await res.json();
        populateUpgradeModal();
    }

    function populateUpgradeModal() {
        const planSelect = document.getElementById('upgradePlan');
        planSelect.innerHTML = '';
        for (const p of eligibility.availablePlans) {
            const opt = document.createElement('option');
            opt.value = p.id;
            opt.textContent = `${p.name} (up to ${p.maxSeats} seats)`;
            opt.dataset.min = p.minSeats;
            opt.dataset.max = p.maxSeats;
            if (p.id === eligibility.currentPlanId) opt.selected = true;
            planSelect.appendChild(opt);
        }
        updateSeatBounds();
    }

    function updateSeatBounds() {
        const opt = document.getElementById('upgradePlan').selectedOptions[0];
        const input = document.getElementById('upgradeSeats');
        input.min   = opt.dataset.min;
        input.max   = opt.dataset.max;
        input.value = eligibility.currentSeats;
        document.getElementById('seatsHelp').textContent =
            `Between ${opt.dataset.min} and ${opt.dataset.max}. You currently use ${eligibility.usedSeats}.`;
    }

    function openUpgrade() {
        if (!eligibility) { alert('Loading...'); return; }
        document.getElementById('upgradeError').textContent = '';
        new bootstrap.Modal(document.getElementById('upgradeModal')).show();
    }

    async function submitUpgrade() {
        const planId    = parseInt(document.getElementById('upgradePlan').value);
        const seats     = parseInt(document.getElementById('upgradeSeats').value);
        const atRenewal = document.getElementById('applyAtRenewal').checked;

        const res = await fetch('/api/subscription/upgrade', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ newSeats: seats, newPlanId: planId, applyNow: !atRenewal })
        });
        const data = await res.json();

        if (!res.ok) {
            document.getElementById('upgradeError').textContent = data.message || 'Upgrade failed.';
            return;
        }

        bootstrap.Modal.getInstance(document.getElementById('upgradeModal')).hide();
        alert(data.message || 'Upgrade submitted.');
        location.reload();
    }

    async function reactivateSubscription() {
        if (!confirm('Reactivate your subscription? It will renew automatically on the end date.')) return;

        const res = await fetch('/api/subscription/cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ atPeriodEnd: false })
        });
        const data = await res.json();
        if (!res.ok) { alert(data.message || resources.someWentWrong); return; }
        location.reload();
    }

    document.getElementById('upgradePlan')?.addEventListener('change', updateSeatBounds);
    loadEligibility();
</script>